# Not part of the build: tool folders the dev watcher would otherwise restart on.
.claude/
.mcp.json

# Docs: not built into either binary. The bare folder lines cover the folder
# itself being created or deleted; the /** lines cover files inside it.
/wiki
/wiki/**
/media
/media/**
/*.md

# Generated licence listings (scripts/third-party-licenses.sh).
/THIRD-PARTY-LICENSES*.txt

# The frontend. Vite hot-reloads it, so `tauri dev` restarting the app on
# every edit here would only throw away the window's state.
/gui/src/
/gui/dist/
/gui/node_modules/
